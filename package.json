{
  "name": "winnotch",
  "version": "1.6.7",
  "description": "Notch — widget système flottant pour Windows 11 (équivalent Dynamic Island)",
  "main": "./out/main/index.js",
  "author": "Jeremy Bolzonella",
  "license": "MIT",
  "homepage": "https://github.com/youhou71/WinNotch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youhou71/WinNotch.git"
  },
  "bugs": {
    "url": "https://github.com/youhou71/WinNotch/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:bundle": "electron-vite build",
    "pack": "npm run build:bundle && electron-builder --dir",
    "dist": "npm run build:bundle && electron-builder",
    "dist:win": "npm run build:bundle && electron-builder --win",
    "rebuild-natives": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@nut-tree-fork/libnut-win32": "^2.7.5",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "loudness": "^0.4.2",
    "mqtt": "^5.15.1",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^7.3.3"
  }
}
